# Anthropic / 兼容网关凭证（配置后启用真实 Claude Agent SDK；不配置则走演示模式）
# 也可不写这里：启动时会自动复用 ~/.claude/settings.json 里的 env
# （如 ANTHROPIC_AUTH_TOKEN、ANTHROPIC_BASE_URL、模型路由等；.env 优先）
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=

# 数据目录（工作区与 SQLite）
DATA_DIR=./data

# Agent 服务端口
AGENT_PORT=8787

# 浏览器打开的工作台地址（登录 Cookie 写在这个源上）
WEB_ORIGIN=http://localhost:3100
# BETTER_AUTH_SECRET=
# 不配则自动写到 $DATA_DIR/auth-secret

# Web 同源反代到 Agent；一般不用改
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
AGENT_INTERNAL_URL=http://localhost:8787
